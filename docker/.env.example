# PostgreSQL Configuration
POSTGRES_USER=azuki
POSTGRES_PASSWORD=azuki
POSTGRES_DB=azuki

# Constructed automatically in docker-compose.yml
# DATABASE_URL=postgres://azuki:azuki@db:5432/azuki

# Inference. Human evaluation uses the serving-only deck-building policy contract.
AZK_INFER_CONFIG=/app/python/config/azuki_human_eval_inference.ini
# Set to /app only when AiModels.modelKey values are repository-relative local paths.
AZK_INFER_LOCAL_MODEL_ROOT=
# Use a long random value outside local development.
AZK_INFER_SHARED_SECRET=local-development-inference-secret

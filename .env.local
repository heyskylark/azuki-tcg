# Local Docker database connection
DATABASE_URL=postgres://azuki:azuki@localhost:5432/azuki

# WebSocket server URL (for client-side connections)
NEXT_PUBLIC_WS_URL=ws://localhost:3001

# Authentication
JWT_SECRET=your-super-secret-jwt-key-min-32-chars
JWT_ISSUER=azuki-tcg
PASSWORD_SALT_ROUNDS=12

# Optional S3 model-loading credentials for python/src/inference_sidecar.py
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=
AWS_PROFILE=azuki-inference
AZK_AWS_REGION=us-east-1
# AZK_AWS_S3_ENDPOINT_URL=
AZK_INFER_S3_MODEL_PREFIX=s3://azuki-tcg-models/
# AZK_INFER_MAX_CONCURRENT_INFERENCES=2
# AZK_INFER_MAX_QUEUE_SIZE=8
# AZK_INFER_QUEUE_WAIT_TIMEOUT_MS=15000
